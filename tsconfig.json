{
  "compilerOptions": {
    "target": "es5",                         // Целевая версия JavaScript
    "lib": ["dom", "esnext"],                // Библиотеки для компиляции
    "esModuleInterop": true,                 // Включает поддержку импорта из CommonJS
    "strict": true,                          // Включает строгую типизацию
    "skipLibCheck": false,                    // Пропускает проверку типов в библиотеках
    "module": "commonjs",                    // Тип модуля
    "moduleResolution": "node",              // Разрешение модулей как в Node.js
    "allowJs": true,                         // Разрешает использование JavaScript файлов
    "jsx": "react-jsx",                      // Использование JSX для React
    "resolveJsonModule": true                // Использование JSON
  },
  "include": [
    "src/**/*"                               // Включает все файлы в папке src
  ]
}
